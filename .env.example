# Supabase
# Replace with values from your Supabase project when auth and data are connected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROPOSAL_PDFS_BUCKET=proposal-pdfs

# Database
DATABASE_URL=



# Recall.ai
RECALL_API_KEY=
RECALL_API_BASE_URL=https://api.recall.ai
RECALL_WEBHOOK_SECRET=



# Company lookup
PAPPERS_API_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
FROM_EMAIL=no-reply@falcondraft.fr
SUPPORT_EMAIL=falcondraft@outlook.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000
FALCONDRAFT_INTERNAL_WORKSPACE_SLUG=falcondraft
FALCONDRAFT_INTERNAL_WORKSPACE_ID=

# Gmail OAuth
# GOOGLE_REDIRECT_URI must end with /api/email/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/oauth/google/callback

# Server-only token encryption.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# PostHog
# Never send call notes, transcripts, proposal content, pricing details, or client-sensitive data.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry
# Optional. The app must keep building when this is empty.
SENTRY_DSN=
