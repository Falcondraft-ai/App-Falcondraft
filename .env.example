NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROPOSAL_PDFS_BUCKET=proposal-pdfs

# Database
DATABASE_URL=

# Workflow automation
# Server-only values used later by FalconDraft API routes.
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=

# Company lookup
PAPPERS_API_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
FROM_EMAIL=no-reply@falcondraft.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000
FALCONDRAFT_INTERNAL_WORKSPACE_SLUG=falcondraft
FALCONDRAFT_INTERNAL_WORKSPACE_ID=
FALCONDRAFT_INTERNAL_ADMIN_EMAILS=

# PostHog
# Never send call notes, transcripts, proposal content, pricing details, or client-sensitive data.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry
# Optional. The app must keep building when this is empty.
SENTRY_DSN=
