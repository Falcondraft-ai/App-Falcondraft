# Supabase
# Replace with values from your Supabase project when auth and data are connected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROPOSAL_PDFS_BUCKET=proposal-pdfs

# Database
DATABASE_URL=



# Recall.ai
RECALL_API_KEY=
RECALL_API_BASE_URL=https://api.recall.ai
RECALL_WEBHOOK_SECRET=



# Company lookup
PAPPERS_API_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FROM_EMAIL=no-reply@falcondraft.fr
SUPPORT_EMAIL=falcondraft@outlook.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000
FALCONDRAFT_INTERNAL_WORKSPACE_SLUG=falcondraft
FALCONDRAFT_INTERNAL_WORKSPACE_ID=

# Gmail OAuth
# GOOGLE_REDIRECT_URI must end with /api/email/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/oauth/google/callback

# Server-only token encryption.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# PostHog
# Never send call notes, transcripts, proposal content, pricing details, or client-sensitive data.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Sentry
# Optional. The app must keep building when these are empty.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_RELEASE=

# N8N secrets
N8N_HEALTH_URL=https://n8n-vr1t.srv1650166.hstgr.cloud/healthz
N8N_BILLING_SECRET=

# Courtier — AI assistant (agent)
# OpenAI key for the courtier assistant (model gpt-5.5). If empty, the assistant
# shows a "not configured" message.
OPENAI_API_KEY=
# Devoir de conseil "motifs" are written by Claude Opus 4.8 (deliberate quality
# exception for the legal document). Requires ANTHROPIC_API_KEY.
# Override the model via COURTIER_ADVICE_MODEL (default claude-opus-4-8).
ANTHROPIC_API_KEY=

# Modèle par tâche — le levier de coût principal du module.
# Règle : le haut de gamme là où la qualité se paie (raisonnement du copilote,
# extraction de chiffres), un palier en dessous pour les tâches à schéma strict.
# Attention : il n'existe pas de "mini" au palier 5.5 — le mini le plus récent
# est gpt-5.4-mini.
#   COURTIER_AGENT_MODEL     copilote agentique        (défaut gpt-5.5)
#   COURTIER_DIGEST_MODEL    tri du courrier           (défaut gpt-5.5)
#   COURTIER_EXTRACT_MODEL   devis/contrats/bordereaux (défaut gpt-5.5)
#   COURTIER_IMPORT_MODEL    reprise de portefeuille   (défaut gpt-5.5)
#   COURTIER_NARRATIVE_MODEL résumé d'ouverture        (défaut gpt-5.4-mini)
#   COURTIER_DOC_MODEL       identification des PJ     (défaut gpt-5.4-mini)
COURTIER_AGENT_MODEL=
COURTIER_DIGEST_MODEL=
COURTIER_EXTRACT_MODEL=
COURTIER_IMPORT_MODEL=
COURTIER_NARRATIVE_MODEL=
COURTIER_DOC_MODEL=
# Pages d'un PDF envoyées pour l'IDENTIFIER (nature, émetteur, concerné).
# L'extraction détaillée reçoit toujours le document complet. Défaut 3.
COURTIER_DOC_MAX_PAGES=
COURTIER_ADVICE_MODEL=

# DocuSeal e-signature (cloud). Create an API key at https://console.docuseal.com.
# Base URL defaults to https://api.docuseal.com (use https://api.docuseal.eu for EU data residency).
DOCUSEAL_API_KEY=
DOCUSEAL_BASE_URL=
# Shared secret authenticating the inbound webhook. Configure the same value in
# DocuSeal → Settings → Webhooks, either as a custom header (X-Docuseal-Secret)
# or appended to the URL (…/api/broker/webhooks/docuseal?token=<secret>).
# Without it the webhook route refuses every call.
DOCUSEAL_WEBHOOK_SECRET=
# Days a signature link stays valid before expiring (default 30).
DOCUSEAL_SIGNATURE_EXPIRY_DAYS=30


# Billing provider credentials (server-side only)
BILLING_CREDENTIALS_ENCRYPTION_KEY=
# Fallback Qonto credentials (used when no billing_connections row exists)
QONTO_API_LOGIN=
QONTO_API_SECRET_KEY=
QONTO_API_BASE_URL=https://thirdparty.qonto.com


